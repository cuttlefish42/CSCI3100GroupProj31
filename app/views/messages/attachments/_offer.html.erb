<%# locals: (offer:, viewer: nil) %>
<% viewer ||= Current.user %>
<div id="offer_<%= offer.id %>" class="card bg-base-100 border border-base-300 shadow-sm mb-2 card-compact">
  <div class="card-body p-3">
    <h3 class="card-title text-sm mt-0 mb-0">
      Offer: <%= link_to offer.item.title, item_path(offer.item), class: "link link-hover" %>
    </h3>
    <div class="flex items-center gap-2">
      <span class="font-semibold text-secondary text-sm"><%= price(offer.price_offered) %></span>
      <span class="badge badge-xs <%= offer_status_badge_class(offer) %>"><%= offer.status.titleize %></span>
    </div>

    <% if viewer && offer.item.seller == viewer && (offer.status == "pending" || offer.status == "countered") %>
      <div class="card-actions justify-end mt-1">
        <%= button_to "Accept", item_offer_acceptance_path(offer.item, offer),
            method: :post,
            class: "btn btn-success btn-xs",
            form: { data: { turbo: true } } %>
        <%= button_to "Reject", item_offer_rejection_path(offer.item, offer),
            method: :post,
            class: "btn btn-error btn-xs",
            form: { data: { turbo: true } } %>
      </div>
    <% elsif viewer && offer.buyer == viewer && offer.status == "countered" %>
      <div class="card-actions justify-end mt-1">
        <%= button_to "Accept Counter", item_offer_counter_acceptance_path(offer.item, offer),
            method: :post,
            class: "btn btn-success btn-xs",
            form: { data: { turbo: true } } %>
        <%= button_to "Reject Counter", item_offer_counter_rejection_path(offer.item, offer),
            method: :post,
            class: "btn btn-error btn-xs",
            form: { data: { turbo: true } } %>
      </div>
    <% elsif viewer && offer.buyer == viewer && offer.status == "pending" %>
      <div class="mt-1">
        <span class="text-xs text-base-content/50 italic">Waiting for seller's response...</span>
      </div>
    <% end %>
  </div>
</div>
