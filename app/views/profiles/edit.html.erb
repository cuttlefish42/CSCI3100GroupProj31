<h1 class="font-bold text-4xl mb-6">Edit Profile</h1>

<%= form_with model: @user, url: profile_path(@user), method: :patch, local: true, class: "max-w-md" do |f| %>
  <% if @user.errors.any? %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
      <h2 class="font-bold"><%= pluralize(@user.errors.count, "error") %> prohibited this profile from being saved:</h2>
      <ul class="list-disc list-inside">
        <% @user.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-4">
    <%= f.label :username, class: "block text-gray-700 font-bold mb-2" %>
    <%= f.text_field :username, class: "w-full px-3 py-2 border rounded-lg focus:outline-none focus:border-blue-500" %>
  </div>

  <div class="mb-4">
    <%= f.label :email_address, class: "block text-gray-700 font-bold mb-2" %>
    <%= f.email_field :email_address, class: "w-full px-3 py-2 border rounded-lg focus:outline-none focus:border-blue-500" %>
  </div>

  <div class="mb-4">
    <%= f.label :bio, class: "block text-gray-700 font-bold mb-2" %>
    <%= f.text_area :bio, rows: 5, placeholder: "Tell us about yourself...", class: "w-full px-3 py-2 border rounded-lg focus:outline-none focus:border-blue-500" %>
  </div>

  <div class="flex gap-4">
    <%= f.submit "Update Profile", class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
    <%= link_to "Cancel", profile_path(@user), class: "bg-gray-500 hover:bg-gray-700 text-white font-bold py-2 px-4 rounded" %>
  </div>
<% end %>