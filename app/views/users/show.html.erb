<div class="min-h-screen bg-base-200 py-8 px-4">
  <div class="max-w-4xl mx-auto">
    <!-- Profile Header -->
    <div class="card bg-base-100 shadow-lg mb-8">
      <div class="card-body">
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
          <div>
            <h1 class="card-title text-4xl mb-2"><%= @user.username %></h1>
            <div class="text-base-content/70 space-y-1">
              <p><strong>Email:</strong> <%= @user.email_address %></p>
              <p><strong>Member since:</strong> <%= @user.created_at.strftime("%B %d, %Y") %></p>
            </div>
          </div>
          <div class="flex flex-col items-end gap-3">
            <div class="badge badge-lg" style="background-color: hsl(var(--s)); color: hsl(var(--sc));">
              Karma: <%= @user.karma || 0 %>
            </div>
            <% if current_user == @user %>
              <%= link_to "Edit Profile", edit_user_path(@user), class: "btn btn-primary btn-sm" %>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Tabs for different sections -->
    <div role="tablist" class="tabs tabs-lifted mb-8">
      <!-- Items Tab -->
      <input type="radio" name="profile_tabs" role="tab" class="tab" aria-label="Items for Sale" checked />
      <div role="tabpanel" class="tab-content bg-base-100 border-base-300 rounded-box p-6">
        <% if @user_items.any? %>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <% @user_items.each do |item| %>
              <div class="card bg-base-200 compact shadow-md hover:shadow-lg transition-shadow">
                <div class="card-body p-4">
                  <div class="flex justify-between items-start">
                    <h3 class="card-title text-lg"><%= link_to item.title || "Item ##{item.id}", item_path(item), class: "link link-primary" %></h3>
                    <div class="badge badge-sm" style="background-color: hsl(var(--in)); color: hsl(var(--inc));">
                      <%= item.status %>
                    </div>
                  </div>
                  <p class="text-base-content/80">Price: <span class="font-semibold text-lg">$<%= item.price %></span></p>
                  <p class="text-base-content/70">Condition: <%= item.condition %></p>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="alert alert-info">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <span>No items listed yet.</span>
          </div>
        <% end %>
      </div>

      <!-- Completed Trades Tab -->
      <input type="radio" name="profile_tabs" role="tab" class="tab" aria-label="Completed Trades" />
      <div role="tabpanel" class="tab-content bg-base-100 border-base-300 rounded-box p-6">
        <% if @completed_trades.any? %>
          <div class="space-y-4">
            <% @completed_trades.each do |trade| %>
              <div class="card bg-base-200 shadow-md hover:shadow-lg transition-shadow">
                <div class="card-body gap-3">
                  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-2">
                    <div>
                      <h3 class="font-semibold text-lg"><%= link_to trade.item.title, item_path(trade.item), class: "link link-primary" %></h3>
                      <p class="text-base-content/70 text-sm">
                        <% if @user == trade.buyer %>
                          Bought from <strong><%= trade.item.seller.username %></strong>
                        <% else %>
                          Sold to <strong><%= trade.buyer.username %></strong>
                        <% end %>
                      </p>
                    </div>
                    <div class="flex items-center gap-2">
                      <span class="text-xl font-bold" style="color: hsl(var(--su));">$<%= trade.price_offered %></span>
                      <div class="badge" style="background-color: hsl(var(--su)); color: hsl(var(--suc));">Completed</div>
                    </div>
                  </div>
                  <div class="text-xs text-base-content/60">
                    Completed on <%= trade.updated_at.strftime("%b %d, %Y") %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="alert alert-info">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <span>No completed trades yet.</span>
          </div>
        <% end %>
      </div>

      <!-- Reviews Received Tab -->
      <input type="radio" name="profile_tabs" role="tab" class="tab" aria-label="Reviews" />
      <div role="tabpanel" class="tab-content bg-base-100 border-base-300 rounded-box p-6">
        <% if @reviews_received.any? %>
          <div class="space-y-4">
            <% @reviews_received.each do |review| %>
              <div class="card bg-base-200 shadow-md hover:shadow-lg transition-shadow">
                <div class="card-body gap-2">
                  <div class="flex justify-between items-start">
                    <div>
                      <div class="flex items-center gap-2 mb-2">
                        <h4 class="font-semibold"><%= link_to review.reviewer.username, user_path(review.reviewer), class: "link link-primary" %></h4>
                        <div class="badge badge-sm" style="background-color: hsl(var(--p)); color: hsl(var(--pc));">
                          <%= review.seller_review? ? "Seller Review" : "Buyer Review" %>
                        </div>
                      </div>
                      <p class="text-base-content/70 text-sm"><%= link_to review.offer.item.title, item_path(review.offer.item), class: "link link-secondary link-hover" %></p>
                    </div>
                    <div class="flex items-center gap-1">
                      <% if review.rating == 1 %>
                        <svg class="w-5 h-5" style="color: hsl(var(--su));" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                        <span class="font-semibold text-green-600">Positive</span>
                      <% else %>
                        <svg class="w-5 h-5" style="color: hsl(var(--er));" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                        <span class="font-semibold text-red-600">Negative</span>
                      <% end %>
                    </div>
                  </div>
                  <p class="text-base-content text-sm">
                    <%= review.comment %>
                  </p>
                  <p class="text-xs text-base-content/50">
                    <%= time_ago_in_words(review.created_at) %> ago
                  </p>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="alert alert-info">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <span>No reviews yet.</span>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Back to Home -->
    <div class="flex justify-center">
      <%= link_to "Back to Home", root_path, class: "btn btn-outline" %>
    </div>
  </div>
</div>