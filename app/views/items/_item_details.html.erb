<%# locals: (item:) %>

<div class="flex-1">
  <% if item.photo.attached? %>
    <div class="bg-base-200 rounded-box flex items-center justify-center p-4 mb-6">
      <%= image_tag item.photo, class: "rounded-box max-h-[500px] object-contain" %>
    </div>
  <% end %>

  <h1 class="text-3xl mb-2"><%= item.title %></h1>
  <p class="text-2xl font-semibold text-secondary mb-6"><%= price(item.price) %></p>

  <div class="divider divider-start text-xl font-semibold">Details</div>
  <div class="grid grid-cols-2 gap-4 mb-8 text-sm">
    <div>
      <p>Condition</p>
      <p class="font-medium"><%= item.condition.humanize %></p>
    </div>
    <div>
      <p>Category</p>
      <p class="font-medium"><%= item.category.name %></p>
    </div>
    <div>
      <p>Listed</p>
      <p class="font-medium"><%= time_ago(item.created_at) %></p>
    </div>
    <div>
      <p>Community</p>
      <p class="font-medium"><%= item.community&.name || "Any" %></p>
    </div>
  </div>

  <% if item.latitude.present? && item.longitude.present? %>
    <h3 class="text-xl font-bold mb-4 border-b border-base-300 pb-2">Meetup Location</h3>
    <div data-controller="map-display"
         data-map-display-lat-value="<%= item.latitude %>"
         data-map-display-lng-value="<%= item.longitude %>"
         data-map-display-note-value="<%= item.meetup_note %>">
      <div data-map-display-target="map" style="height: 300px; border-radius: 8px;"></div>
    </div>
    <% if item.meetup_note.present? %>
      <p class="mt-2 text-sm"><strong>Note:</strong> <%= item.meetup_note %></p>
    <% end %>
    <div class="mb-8"></div>
  <% end %>

  <div class="flex items-center gap-4 text-sm text-base-content/60 my-4">
    <span><%= item.views_count %> views</span>
    <span><%= item.likes_count %> likes</span>
    <% if Current.user && Current.user != item.seller %>
      <%= button_to toggle_like_item_path(item), method: :post, class: "btn btn-sm #{@liked ? 'btn-primary' : 'btn-outline'}" do %>
        <%= @liked ? "Unlike" : "Like" %>
      <% end %>
    <% end %>
  </div>

  <div class="flex gap-4 my-4">
    <%= link_to "Back", items_path, class: "btn btn-outline" %>
    <% if Current.user == item.seller %>
      <%= link_to "Edit", edit_item_path(item), class: "btn btn-primary" %>
      <%= link_to "Delete", item, data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "btn btn-error" %>
    <% end %>
  </div>
</div>
