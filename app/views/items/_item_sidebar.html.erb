<%# locals: (item:, existing_offer:, offer:) %>

<div class="w-full md:w-80 flex flex-col gap-4">
  <div class="card card-border bg-base-100 shadow-xl">
    <div class="card-body">
      <div class="flex items-center gap-4">
        <%= render "shared/user_avatar", user: item.seller, size: "lg" %>
        <div>
          <p class="font-bold"><%= link_to item.seller.full_name, user_path(item.seller) %></p>
          <p class="text-xs">Karma: <%= item.seller.karma %></p>
        </div>
      </div>

      <div class="divider"></div>

<%# === Offer section (for logged-in buyers, only on available items) === %>
<% if Current.user && Current.user != item.seller && item.available? %>
  <% if existing_offer %>
    <div class="alert bg-base-200 text-base-content text-sm">
      <div>
        <p class="font-semibold">You already have an active offer on this item</p>
        <p class="text-xs"><%= price(existing_offer.price_offered) %> &mdash; <%= existing_offer.status.humanize %></p>
      </div>
      <% if existing_offer.countered? && existing_offer.counter_price %>
        <div class="mt-2">
          <span class="text-warning-content font-bold block mb-2">The seller has countered with <%= price(existing_offer.counter_price) %>.</span>
          <div class="flex gap-2">
            <%= button_to "Accept Counter", item_offer_path(item, existing_offer),
                  method: :patch,
                  params: { offer: { status: "accept_counter" } },
                  class: "btn btn-success btn-sm",
                  data: { turbo_confirm: "Accept the counter-offer of #{number_to_currency(existing_offer.counter_price)}?" } %>
            <%= button_to "Reject Counter", item_offer_path(item, existing_offer),
                  method: :patch,
                  params: { offer: { status: "reject_counter" } },
                  class: "btn btn-error btn-sm",
                  data: { turbo_confirm: "Reject the counter-offer? You can make a new offer afterwards." } %>
          </div>
        </div>
      <% end %>
    </div>

    <%= link_to "Edit Your Offer", new_item_offer_path(item), class: "btn btn-outline w-full my-2" %>

  <% else %>
    <%= link_to "Make an Offer", new_item_offer_path(item), class: "btn btn-outline w-full my-2" %>
  <% end %>
<% end %>

<% if Current.user && Current.user != item.seller %>
  <%= button_to "Chat", conversations_path(item_id: item.id),
      params: { receiver_id: item.seller.id },
      class: "btn btn-primary w-full" %>
<% end %>

    </div>
  </div>
</div>
