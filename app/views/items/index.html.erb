<div class="container mx-auto p-4">
  <div class="flex items-center justify-between mb-4">
    <h2>Marketplace Items</h2>
    <% if authenticated? %>
      <%= link_to "New Item", new_item_path, class: "btn btn-primary btn-sm" %>
    <% end %>
  </div>

  <% if @active_community_id %>
    <div class="flex items-center gap-2 mb-4">
      <span class="badge badge-primary"><%= Community.find(@active_community_id).name %></span>
      <%= link_to "Clear filter", items_path, class: "btn btn-ghost btn-xs" %>
    </div>
  <% end %>

  <% if @items.any? %>
      <%# Grid layout %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 items-start">
      <% @items.each do |item| %>
        <%= render item, link_title: true %>
      <% end %>
    </div>
  <% else %>
    <p class="text-neutral/70 italic">No items yet.</p>
  <% end %>
</div>
