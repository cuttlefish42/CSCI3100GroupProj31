<%# locals: (item:) %>

<div class="flex-1">
  <% if item.photo.attached? %>
    <div class="bg-base-100 rounded-2xl flex items-center justify-center p-6 mb-8 shadow-sm">
      <%= image_tag item.photo, class: "rounded-xl max-h-[500px] object-contain" %>
    </div>
  <% end %>

  <h1 class="text-3xl font-bold mb-3"><%= item.title %></h1>
  <p class="text-3xl font-extrabold text-primary mb-4"><%= price(item.price) %></p>

  <div class="flex items-center gap-3 mb-8">
    <span class="badge badge-ghost"><%= lucide_icon("eye", class: "w-3 h-3") %> <%= item.views_count %> views</span>
    <%= render "items/like_button", item: item %>
    <span class="badge badge-ghost"><%= item.condition.humanize %></span>
  </div>

  <div class="card bg-base-100 shadow-sm p-6 mb-6">
    <h2 class="text-lg font-bold mb-3">Description</h2>
    <p class="whitespace-pre-line text-base-content/80"><%= item.description %></p>
  </div>

  <div class="card bg-base-100 shadow-sm p-6 mb-6">
    <h2 class="text-lg font-bold mb-4">Details</h2>
    <div class="grid grid-cols-2 gap-6 text-sm">
      <div>
        <p class="text-xs uppercase font-semibold text-base-content/40 mb-1">Condition</p>
        <p class="font-medium"><%= item.condition.humanize %></p>
      </div>
      <div>
        <p class="text-xs uppercase font-semibold text-base-content/40 mb-1">Category</p>
        <p class="font-medium"><%= item.category.name %></p>
      </div>
      <div>
        <p class="text-xs uppercase font-semibold text-base-content/40 mb-1">Listed</p>
        <p class="font-medium"><%= time_ago(item.created_at) %></p>
      </div>
      <div>
        <p class="text-xs uppercase font-semibold text-base-content/40 mb-1">Community</p>
        <p class="font-medium"><%= item.community&.name || "Any" %></p>
      </div>
    </div>
  </div>

  <% if item.latitude.present? && item.longitude.present? %>
    <div class="card bg-base-100 shadow-sm p-6 mb-6">
      <h2 class="text-lg font-bold mb-4">Meetup Location</h2>
      <div data-controller="map-display"
           data-map-display-lat-value="<%= item.latitude %>"
           data-map-display-lng-value="<%= item.longitude %>"
           data-map-display-note-value="<%= item.meetup_note %>">
        <div data-map-display-target="map" style="height: 300px; border-radius: 12px;"></div>
      </div>
      <% if item.meetup_note.present? %>
        <p class="mt-3 text-sm text-base-content/70"><strong>Note:</strong> <%= item.meetup_note %></p>
      <% end %>
    </div>
  <% end %>

  <div class="flex gap-3 mt-6">
    <%= link_to items_path, class: "btn btn-ghost" do %>
      <%= lucide_icon("arrow-left", class: "w-4 h-4") %> Back
    <% end %>
    <% if Current.user == item.seller %>
      <%= link_to "Edit", edit_item_path(item), class: "btn btn-primary" %>
      <%= link_to "Delete", item, data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "btn btn-error btn-outline" %>
    <% end %>
  </div>
</div>
