<%= render "header" %>

<%= render @item %>

<p>
	<%= link_to "Back", items_path %>
    | <%= link_to "Edit", edit_item_path(@item) %>
    | <%= link_to "Delete", @item, data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
</p>

<%# === Offer section (for logged-in buyers, only on available items) === %>
<% if Current.user && Current.user != @item.seller && @item.available? %>
  <% if @existing_offer %>
    <%# --- Existing offer banner with counter-offer actions --- %>
    <div style="border: 1px solid #cc8800; background: #fff8e1; padding: 12px; margin: 12px 0; border-radius: 4px;">
      <strong>You already have an active offer on this item
      (<%= number_to_currency(@existing_offer.price_offered) %> &mdash; <%= @existing_offer.status.humanize %>).</strong>
      <% if @existing_offer.countered? && @existing_offer.counter_price %>
        <br><span style="color: #b36b00;">The seller has countered with <strong><%= number_to_currency(@existing_offer.counter_price) %></strong>.</span>
        <br>
        <%= button_to "Accept Counter", item_offer_path(@item, @existing_offer),
              method: :patch,
              params: { offer: { status: "accept_counter" } },
              data: { turbo_confirm: "Accept the counter-offer of #{number_to_currency(@existing_offer.counter_price)}?" },
              style: "display:inline-block; margin-top: 8px;" %>
        <%= button_to "Reject Counter", item_offer_path(@item, @existing_offer),
              method: :patch,
              params: { offer: { status: "reject_counter" } },
              data: { turbo_confirm: "Reject the counter-offer? You can make a new offer afterwards." },
              style: "display:inline-block; margin-top: 8px;" %>
      <% end %>
    </div>

    <%# --- Edit Offer popup modal (base = current offer price) --- %>
    <div data-controller="offer-price" data-offer-price-base-value="<%= @existing_offer.price_offered %>">
      <button type="button" data-action="offer-price#open" style="margin: 8px 0; padding: 8px 16px; font-size: 1em; cursor: pointer;">
        Edit Your Offer
      </button>

      <div data-offer-price-target="modal" data-action="click->offer-price#close"
           style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1000; justify-content:center; align-items:center;">
        <div style="background:#fff; padding:24px; border-radius:8px; max-width:420px; width:90%; position:relative;" data-action="click->offer-price#stopPropagation">
          <button type="button" data-action="offer-price#close" style="position:absolute; top:8px; right:12px; background:none; border:none; font-size:1.4em; cursor:pointer;">&times;</button>
          <h2 style="margin-top:0;">Edit Your Offer</h2>
          <p style="color:#666; font-size:0.9em;">Current offer: <strong><%= number_to_currency(@existing_offer.price_offered) %></strong></p>
          <%= form_with model: [@item, @existing_offer] do |f| %>
            <p>
              <%= f.label :price_offered, "Your Offer ($)" %><br>
              <%= f.number_field :price_offered, step: 0.01, min: 0.01, required: true,
                    data: { offer_price_target: "input" } %>
            </p>
            <p style="margin-top: 4px;">
              <strong>Quick adjust:</strong><br>
              <button type="button" data-action="offer-price#adjust" data-pct="0.5" style="margin: 2px;">-50%</button>
              <button type="button" data-action="offer-price#adjust" data-pct="0.75" style="margin: 2px;">-25%</button>
              <button type="button" data-action="offer-price#adjust" data-pct="0.9" style="margin: 2px;">-10%</button>
              <button type="button" data-action="offer-price#adjust" data-pct="1.1" style="margin: 2px;">+10%</button>
              <button type="button" data-action="offer-price#adjust" data-pct="1.25" style="margin: 2px;">+25%</button>
              <span style="color: #666; font-size: 0.85em;">(of your current offer)</span>
            </p>
            <p>
              <%= f.label :message, "Message (optional)" %><br>
              <%= f.text_area :message, rows: 3, placeholder: "Add a note to the seller..." %>
            </p>
            <p><%= f.submit "Update Offer", style: "padding: 8px 20px;" %></p>
          <% end %>
        </div>
      </div>
    </div>

  <% else %>
    <%# --- Make an Offer popup modal (base = listing price) --- %>
    <div data-controller="offer-price" data-offer-price-base-value="<%= @item.price %>">
      <button type="button" data-action="offer-price#open" style="margin: 8px 0; padding: 8px 16px; font-size: 1em; cursor: pointer;">
        Make an Offer
      </button>

      <div data-offer-price-target="modal" data-action="click->offer-price#close"
           style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1000; justify-content:center; align-items:center;">
        <div style="background:#fff; padding:24px; border-radius:8px; max-width:420px; width:90%; position:relative;" data-action="click->offer-price#stopPropagation">
          <button type="button" data-action="offer-price#close" style="position:absolute; top:8px; right:12px; background:none; border:none; font-size:1.4em; cursor:pointer;">&times;</button>
          <h2 style="margin-top:0;">Make an Offer</h2>
          <p style="color:#666; font-size:0.9em;">Listing price: <strong><%= number_to_currency(@item.price) %></strong></p>
          <%= form_with model: [@item, @offer] do |f| %>
            <p>
              <%= f.label :price_offered, "Your Offer ($)" %><br>
              <%= f.number_field :price_offered, step: 0.01, min: 0.01, required: true,
                    data: { offer_price_target: "input" } %>
            </p>
            <p style="margin-top: 4px;">
              <strong>Quick set:</strong><br>
              <button type="button" data-action="offer-price#adjust" data-pct="0.5" style="margin: 2px;">-50%</button>
              <button type="button" data-action="offer-price#adjust" data-pct="0.75" style="margin: 2px;">-25%</button>
              <button type="button" data-action="offer-price#adjust" data-pct="0.9" style="margin: 2px;">-10%</button>
              <button type="button" data-action="offer-price#adjust" data-pct="1.0" style="margin: 2px;">Listing price</button>
              <span style="color: #666; font-size: 0.85em;">(of <%= number_to_currency(@item.price) %>)</span>
            </p>
            <p>
              <%= f.label :message, "Message (optional)" %><br>
              <%= f.text_area :message, rows: 3, placeholder: "Add a note to the seller..." %>
            </p>
            <p><%= f.submit "Submit Offer", style: "padding: 8px 20px;" %></p>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
<% end %>

<%# === Offers list (visible to seller) === %>
<% if Current.user == @item.seller && @offers.any? %>
  <h2>Offers Received</h2>
  <table>
    <thead>
      <tr>
        <th><%= sortable_header("Buyer", "buyer", @offer_sort, @offer_dir, sort_param: "offer_sort", dir_param: "offer_dir") %></th>
        <th><%= sortable_header("Amount", "price", @offer_sort, @offer_dir, sort_param: "offer_sort", dir_param: "offer_dir") %></th>
        <th>Message</th>
        <th><%= sortable_header("Status", "status", @offer_sort, @offer_dir, sort_param: "offer_sort", dir_param: "offer_dir") %></th>
        <th><%= sortable_header("Date", "date", @offer_sort, @offer_dir, sort_param: "offer_sort", dir_param: "offer_dir") %></th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @offers.each do |offer| %>
        <tr>
          <td><%= offer.buyer.email_address %></td>
          <td><%= number_to_currency(offer.price_offered) %></td>
          <td><%= offer.message.presence || "—" %></td>
          <td>
            <%= offer.status.humanize %>
            <% if offer.countered? && offer.counter_price %>
              (<%= number_to_currency(offer.counter_price) %>)
            <% end %>
          </td>
          <td><%= time_ago_in_words(offer.updated_at) %> ago</td>
          <td>
            <% if offer.pending? %>
                <%= button_to "Accept", item_offer_acceptance_path(offer.item, offer),
                      method: :post,
                      data: { turbo_confirm: "Accept this offer?" } %>
                <%= button_to "Reject", item_offer_rejection_path(offer.item, offer),
                      method: :post,
                      data: { turbo_confirm: "Reject this offer?" } %>
              <%= form_with url: item_offer_counter_path(offer.item, offer), method: :post, style: "display:inline" do |f| %>
                <%= f.hidden_field :status, value: "countered", name: "offer[status]" %>
                <%= f.number_field :counter_price, step: 0.01, min: 0.01, placeholder: "Counter $", name: "offer[counter_price]", style: "width:100px" %>
                <%= f.submit "Counter" %>
              <% end %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<%# === All offers on this item (visible to any logged-in user who is not the seller) === %>
<% if Current.user && Current.user != @item.seller && @offers.any? %>
  <h2>Offers on This Item</h2>
  <table>
    <thead>
      <tr>
        <th><%= sortable_header("Buyer", "buyer", @offer_sort, @offer_dir, sort_param: "offer_sort", dir_param: "offer_dir") %></th>
        <th><%= sortable_header("Amount", "price", @offer_sort, @offer_dir, sort_param: "offer_sort", dir_param: "offer_dir") %></th>
        <th>Message</th>
        <th><%= sortable_header("Status", "status", @offer_sort, @offer_dir, sort_param: "offer_sort", dir_param: "offer_dir") %></th>
        <th><%= sortable_header("Date", "date", @offer_sort, @offer_dir, sort_param: "offer_sort", dir_param: "offer_dir") %></th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @offers.each do |offer| %>
        <tr>
          <td><%= offer.buyer == Current.user ? "You" : offer.buyer.email_address %></td>
          <td><%= number_to_currency(offer.price_offered) %></td>
          <td><%= offer.message.presence || "—" %></td>
          <td>
            <% if offer.countered? && offer.counter_price %>
              <span style="color: #b36b00; font-weight: bold;">
                Seller countered: <%= number_to_currency(offer.counter_price) %>
              </span>
            <% else %>
              <%= offer.status.humanize %>
            <% end %>
          </td>
          <td><%= time_ago_in_words(offer.updated_at) %> ago</td>
          <td>
            <% if offer.buyer == Current.user && offer.countered? %>
              <%= button_to "Accept Counter", item_offer_path(@item, offer),
                    method: :patch,
                    params: { offer: { status: "accept_counter" } },
                    data: { turbo_confirm: "Accept the counter-offer of #{number_to_currency(offer.counter_price)}?" } %>
              <%= button_to "Reject Counter", item_offer_path(@item, offer),
                    method: :patch,
                    params: { offer: { status: "reject_counter" } },
                    data: { turbo_confirm: "Reject the counter-offer? You can make a new offer afterwards." } %>
              <%= button_to "Withdraw", item_offer_path(@item, offer),
                    method: :delete,
                    data: { turbo_confirm: "Withdraw this offer?" } %>
            <% elsif offer.buyer == Current.user && offer.pending? %>
              <%= button_to "Withdraw", item_offer_path(@item, offer),
                    method: :delete,
                    data: { turbo_confirm: "Withdraw this offer?" } %>
              <button type="button" onclick="document.querySelector('[data-action=\'offer-price#open\']').click()" style="margin-left: 6px; cursor: pointer;">Edit Offer</button>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
