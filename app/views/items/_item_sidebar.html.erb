<div class="w-full md:w-80 flex flex-col gap-4">
  <div class="card bg-base-100 shadow-xl border border-base-200">
    <div class="card-body p-6">
      <div class="flex items-center gap-4 mb-4 border-b border-base-300 pb-4">
        <div class="avatar placeholder">
          <div class="bg-neutral text-neutral-content rounded-full w-12 h-12 flex items-center justify-center">
            <span class="text-xl font-bold"><%= @item.seller.username[0].upcase %></span>
          </div>
        </div>
        <div>
          <p class="font-bold">@<%= @item.seller.username %></p>
          <p class="text-xs text-neutral/70">Karma: <%= @item.seller.karma %></p>
        </div>
      </div>

<%# === Offer section (for logged-in buyers, only on available items) === %>
<% if Current.user && Current.user != @item.seller && @item.available? %>
  <% if @existing_offer %>
    <%# --- Existing offer banner with counter-offer actions --- %>
    <div class="alert alert-warning mb-6 shadow-md">
      <div>
        <h3 class="font-bold">You already have an active offer on this item</h3>
        <p>(<%= number_to_currency(@existing_offer.price_offered) %> &mdash; <%= @existing_offer.status.humanize %>)</p>
      </div>
      <% if @existing_offer.countered? && @existing_offer.counter_price %>
        <div class="mt-2">
          <span class="text-warning-content font-bold block mb-2">The seller has countered with <%= number_to_currency(@existing_offer.counter_price) %>.</span>
          <div class="flex gap-2">
            <%= button_to "Accept Counter", item_offer_path(@item, @existing_offer),
                  method: :patch,
                  params: { offer: { status: "accept_counter" } },
                  class: "btn btn-success btn-sm",
                  data: { turbo_confirm: "Accept the counter-offer of #{number_to_currency(@existing_offer.counter_price)}?" } %>
            <%= button_to "Reject Counter", item_offer_path(@item, @existing_offer),
                  method: :patch,
                  params: { offer: { status: "reject_counter" } },
                  class: "btn btn-error btn-sm",
                  data: { turbo_confirm: "Reject the counter-offer? You can make a new offer afterwards." } %>
          </div>
        </div>
      <% end %>
    </div>

    <%# --- Edit Offer popup modal (base = current offer price) --- %>
    <div data-controller="offer-price" data-offer-price-base-value="<%= @existing_offer.price_offered %>">
      <button type="button" data-action="offer-price#open" class="btn btn-outline w-full my-2">
        Edit Your Offer
      </button>

      <div data-offer-price-target="modal" data-action="click->offer-price#close"
           class="fixed inset-0 bg-neutral/50 z-50 flex justify-center items-center" style="display:none;">
        <div class="bg-base-100 rounded-xl p-6 shadow-xl relative w-11/12 max-w-sm" data-action="click->offer-price#stopPropagation">
          <button type="button" data-action="offer-price#close" class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
          <h3 class="text-lg font-bold">Edit Your Offer</h3>
          <p class="text-sm text-neutral/70 mb-4">Current offer: <strong><%= number_to_currency(@existing_offer.price_offered) %></strong></p>
          <%= form_with model: [@item, @existing_offer], class: "flex flex-col gap-4" do |f| %>
            <div class="form-control">
              <%= f.label :price_offered, "Your Offer ($)", class: "label font-semibold" %>
              <%= f.number_field :price_offered, step: 0.01, min: 0.01, required: true,
                    class: "input input-bordered w-full", data: { offer_price_target: "input" } %>
            </div>
            <div>
              <span class="text-sm font-semibold">Quick adjust:</span>
              <div class="flex flex-wrap gap-2 mt-2">
                <button type="button" class="btn btn-xs btn-outline" data-action="offer-price#adjust" data-pct="0.5">-50%</button>
                <button type="button" class="btn btn-xs btn-outline" data-action="offer-price#adjust" data-pct="0.75">-25%</button>
                <button type="button" class="btn btn-xs btn-outline" data-action="offer-price#adjust" data-pct="0.9">-10%</button>
                <button type="button" class="btn btn-xs btn-outline" data-action="offer-price#adjust" data-pct="1.1">+10%</button>
                <button type="button" class="btn btn-xs btn-outline" data-action="offer-price#adjust" data-pct="1.25">+25%</button>
              </div>
              <span class="text-xs text-neutral/70 mt-1 block">(of your current offer)</span>
            </div>
            <div class="form-control">
              <%= f.label :message, "Message (optional)", class: "label font-semibold" %>
              <%= f.text_area :message, rows: 3, class: "textarea textarea-bordered w-full", placeholder: "Add a note to the seller..." %>
            </div>
            <div class="mt-4">
              <%= f.submit "Update Offer", class: "btn btn-primary w-full" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

  <% else %>
    <%# --- Make an Offer popup modal (base = listing price) --- %>
    <div data-controller="offer-price" data-offer-price-base-value="<%= @item.price %>">
      <button type="button" data-action="offer-price#open" class="btn btn-outline w-full my-2">
        Make an Offer
      </button>

      <div data-offer-price-target="modal" data-action="click->offer-price#close"
           class="fixed inset-0 bg-neutral/50 z-50 flex justify-center items-center" style="display:none;">
        <div class="bg-base-100 rounded-xl p-6 shadow-xl relative w-11/12 max-w-sm" data-action="click->offer-price#stopPropagation">
          <button type="button" data-action="offer-price#close" class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
          <h3 class="text-lg font-bold">Make an Offer</h3>
          <p class="text-sm text-neutral/70 mb-4">Listing price: <strong><%= number_to_currency(@item.price) %></strong></p>
          <%= form_with model: [@item, @offer], class: "flex flex-col gap-4" do |f| %>
            <div class="form-control">
              <%= f.label :price_offered, "Your Offer ($)", class: "label font-semibold" %>
              <%= f.number_field :price_offered, step: 0.01, min: 0.01, required: true,
                    class: "input input-bordered w-full", data: { offer_price_target: "input" } %>
            </div>
            <div>
              <span class="text-sm font-semibold">Quick set:</span>
              <div class="flex flex-wrap gap-2 mt-2">
                <button type="button" class="btn btn-xs btn-outline" data-action="offer-price#adjust" data-pct="0.5">-50%</button>
                <button type="button" class="btn btn-xs btn-outline" data-action="offer-price#adjust" data-pct="0.75">-25%</button>
                <button type="button" class="btn btn-xs btn-outline" data-action="offer-price#adjust" data-pct="0.9">-10%</button>
                <button type="button" class="btn btn-xs btn-outline" data-action="offer-price#adjust" data-pct="1.0">Listing price</button>
              </div>
              <span class="text-xs text-neutral/70 mt-1 block">(of <%= number_to_currency(@item.price) %>)</span>
            </div>
            <div class="form-control">
              <%= f.label :message, "Message (optional)", class: "label font-semibold" %>
              <%= f.text_area :message, rows: 3, class: "textarea textarea-bordered w-full", placeholder: "Add a note to the seller..." %>
            </div>
            <div class="mt-4">
              <%= f.submit "Submit Offer", class: "btn btn-primary w-full" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
<% end %>

      <button class="btn btn-primary w-full mt-2">Chat</button>

    </div>
  </div>
</div>
