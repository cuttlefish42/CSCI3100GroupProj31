<%# locals: (message:) %>

<% is_mine = message.sender == Current.user %>

<div id="<%= dom_id(message) %>" class="chat <%= is_mine ? 'chat-end' : 'chat-start' %>">
  <div class="chat-header text-base-content/60">
    <%= is_mine ? "You" : message.sender.username %>
  </div>
  <div class="chat-bubble <%= is_mine ? 'chat-bubble-primary' : '' %>">
    <% if message.offer.present? %>
      <%= render "messages/attachments/offer", offer: message.offer %>
    <% elsif message.item.present? %>
      <%= render "messages/attachments/item", item: message.item %>
    <% end %>
    <%= message.content %>
  </div>
  <div class="chat-footer text-base-content/40">
    <time class="text-xs"><%= time_ago_in_words(message.created_at) %> ago</time>
  </div>
</div>
