<%# locals: (item:) %>
<div class="card bg-base-200 shadow-sm mb-2 card-compact">
  <div class="card-body p-3">
    <h3 class="card-title text-sm mt-0 mb-0">
      <%= link_to item.title, item_path(item), class: "link link-hover" %>
    </h3>
    <div class="flex items-center gap-2">
      <% if item.price.present? %>
        <span class="font-semibold text-secondary text-sm"><%= number_to_currency(item.price) %></span>
      <% end %>
      <span class="badge badge-xs <%= item_status_badge_class(item) %>"><%= item.status.humanize %></span>
    </div>
  </div>
</div>
