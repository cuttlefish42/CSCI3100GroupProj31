<aside class="w-64 shrink-0 bg-base-200 p-4 overflow-y-auto hidden lg:block">
  <ul class="menu menu-sm w-full mb-4">
    <% if authenticated? %>
      <li>
        <%= link_to items_path(feed: "my"),
              class: "#{@active_feed == 'my' ? 'active' : ''} font-semibold" do %>
          <%= lucide_icon("home", class: "w-4 h-4") %> My Feed
        <% end %>
      </li>
    <% end %>
    <li>
      <%= link_to items_path,
            class: "#{@active_feed.nil? && @active_community_id.nil? ? 'active' : ''} font-semibold" do %>
        <%= lucide_icon("globe", class: "w-4 h-4") %> All Items
      <% end %>
    </li>
  </ul>

  <div class="divider my-1"></div>

  <h3 class="font-bold text-sm uppercase tracking-wide text-base-content/50 mb-3">Communities</h3>

  <% Community.grouped_by_type.each do |type, communities| %>
    <div class="collapse collapse-arrow bg-base-100 mb-2">
      <input type="checkbox" checked />
      <div class="collapse-title font-semibold text-sm"><%= type || "Other" %></div>
      <div class="collapse-content p-0">
        <ul class="menu menu-sm">
          <% communities.each do |community| %>
            <li>
              <%= link_to community.name, community_path(community),
                    class: "#{community.id == @active_community_id ? 'active' : ''}" %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="mt-4">
    <%= link_to "All Communities", communities_path, class: "btn btn-ghost btn-sm btn-block" %>
  </div>
</aside>
