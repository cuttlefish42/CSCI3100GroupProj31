<%# locals: (item:, link_title: false, large_photo: false) %>

<div class="card bg-base-100 border border-base-200 <%= large_photo ? 'w-full max-w-2xl' : '' %>">
  <% if item.photo.attached? %>
    <figure class="px-4 pt-4">
      <%= image_tag item.photo, class: "rounded-xl #{large_photo ? 'max-h-96 object-contain' : 'max-h-48 object-cover'}" %>
    </figure>
  <% end %>

  <div class="card-body">
    <h1 class="card-title">
      <% if link_title %>
        <%= link_to item.title, item %>
      <% else %>
        <%= item.title %>
      <% end %>
    </h1>

    <p class="text-xl font-bold text-secondary mb-2"><%= number_to_currency(item.price) %></p>

    <div class="text-sm space-y-1">
      <p><strong>Category:</strong> <%= item.category.name %></p>
      <p><strong>Condition:</strong> <%= item.condition.humanize %></p>
      <p><strong>Community:</strong> <%= item.community&.name || "Any" %></p>
      <p>
        <strong>Status:</strong>
        <span class="badge badge-info badge-sm"><%= item.status.humanize %></span>
      </p>
      <p>
        <strong>Seller:</strong> <%= item.seller.username %>
        <span class="badge badge-ghost badge-sm">[<%= item.seller.karma %>]</span>
      </p>
    </div>
  </div>
</div>
