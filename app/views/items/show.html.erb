<div class="max-w-5xl mx-auto p-6">
  <div class="flex flex-col md:flex-row gap-8">
    <%# Left Column — item details %>
    <%= render "item_details", item: @item %>

    <%# Right Column — seller card + actions %>
    <%= render "item_sidebar", item: @item, existing_offer: @existing_offer, offer: @offer %>
  </div>

  <div class="mt-8">
    <%= render "item_offers", item: @item, offers: @offers, offer_sort: @offer_sort, offer_dir: @offer_dir %>
  </div>
</div>
