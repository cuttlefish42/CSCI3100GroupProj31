#!/usr/bin/env ruby
require "bundler/setup"
require "simplecov"
require "json"

SimpleCov.start "rails" do
  enable_coverage :branch
  primary_coverage :branch
end

resultsets = Dir["coverage-data/**/.resultset.json"]
puts "Found resultsets: #{resultsets.join(', ')}"

if resultsets.empty?
  puts "No coverage data found."
  exit 1
end

result = SimpleCov.collate(resultsets)

# Output summary to GitHub Step Summary if available
if ENV["GITHUB_STEP_SUMMARY"]
  File.open(ENV["GITHUB_STEP_SUMMARY"], "a") do |f|
    f.puts "## Test Coverage Report"
    f.puts "| Job | Lines | Branches |"
    f.puts "| --- | --- | --- |"
    
    # SimpleCov.collate returns a merged Result object.
    line_pc = result.covered_percent.round(2)
    branch_pc = result.respond_to?(:covered_branches_percent) ? result.covered_branches_percent.round(2) : "N/A"
    
    f.puts "| **Merged Total** | **#{line_pc}%** | **#{branch_pc}%** |"
    
    f.puts "\n*Detailed HTML report available in artifacts (coverage-merged).* "
  end
end
