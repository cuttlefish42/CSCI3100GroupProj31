<div class="container mx-auto p-4">
  <div class="flex items-center justify-between mb-4">
    <div>
      <h1 class="text-3xl font-bold"><%= @community.name %></h1>
      <p class="text-base-content/60"><%= @community.community_type %></p>
    </div>
    <div class="flex gap-2">
      <% if authenticated? %>
        <% if @is_member %>
          <%= button_to "Leave", leave_community_path(@community), method: :delete, class: "btn btn-outline btn-sm" %>
        <% else %>
          <%= button_to "Join", join_community_path(@community), method: :post, class: "btn btn-primary btn-sm" %>
        <% end %>
      <% end %>
      <% if @is_admin %>
        <button class="btn btn-outline btn-sm" onclick="document.getElementById('rules-form').classList.toggle('hidden')">Edit Rules</button>
      <% end %>
    </div>
  </div>

  <%# Listing rules banner %>
  <% if @community.listing_rules.present? %>
    <div class="alert bg-base-200 text-base-content mb-6">
      <div class="prose prose-sm max-w-none">
        <%= @community.listing_rules %>
      </div>
    </div>
  <% end %>

  <%# Admin: edit rules form (hidden by default, toggled by "Edit Rules" button) %>
  <% if @is_admin %>
    <div id="rules-form" class="card bg-base-100 shadow-md mb-6 hidden">
      <div class="card-body">
        <h3 class="card-title text-base">Edit Listing Rules</h3>
        <%= form_with model: @community do |f| %>
          <div class="mb-4">
            <%= f.rich_text_area :listing_rules, class: "min-h-[120px]" %>
          </div>
          <%= f.submit "Save Rules", class: "btn btn-primary btn-sm" %>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Items grid %>
  <h2 class="text-xl font-semibold mb-4">Items (<%= @items.count %>)</h2>
  <% if @items.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @items.each do |item| %>
        <%= render item, link_title: true, admin: @is_admin %>
      <% end %>
    </div>
  <% else %>
    <p class="text-base-content/50">No items listed in this community yet.</p>
  <% end %>
</div>
