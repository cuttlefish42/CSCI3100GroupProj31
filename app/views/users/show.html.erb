<div class="min-h-screen bg-base-200 py-8 px-4">
  <div class="max-w-4xl mx-auto">
    <%# Profile Header %>
    <div class="card bg-gradient-to-r from-primary/10 to-accent/10 shadow-lg mb-8">
      <div class="card-body">
        <div class="flex items-center gap-4">
          <%= render "shared/user_avatar", user: @user, size: "xl" %>
          <div class="flex-1">
            <h1 class="text-3xl font-bold"><%= @user.full_name %></h1>
            <p class="text-base-content/60">Member since <%= @user.created_at.strftime("%B %Y") %></p>
          </div>
          <div class="badge badge-accent badge-lg font-bold">Karma: <%= @user.karma %></div>
        </div>
      </div>
    </div>

    <%# Tabs %>
    <div role="tablist" class="tabs tabs-lifted mb-8">
      <input type="radio" name="profile_tabs" role="tab" class="tab" aria-label="Items for Sale" checked />
      <div role="tabpanel" class="tab-content bg-base-100 border-base-300 rounded-box p-6">
        <%= render "users/items_tab", items: @user_items %>
      </div>

      <input type="radio" name="profile_tabs" role="tab" class="tab" aria-label="Completed Trades" />
      <div role="tabpanel" class="tab-content bg-base-100 border-base-300 rounded-box p-6">
        <%= render "users/trades_tab", trades: @completed_trades, user: @user %>
      </div>

      <input type="radio" name="profile_tabs" role="tab" class="tab" aria-label="Reviews" />
      <div role="tabpanel" class="tab-content bg-base-100 border-base-300 rounded-box p-6">
        <%= render "users/reviews_tab", reviews: @reviews_received %>
      </div>
    </div>
  </div>
</div>
