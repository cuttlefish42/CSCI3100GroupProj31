<%= render "items/header" %>

<h1>My Offers</h1>

<h2>Offers I've Made</h2>
<% if @sent_offers.any? %>
  <table>
    <thead>
      <tr>
        <th><%= sortable_header("Item", "item", @sent_sort, @sent_dir, sort_param: "sent_sort", dir_param: "sent_dir") %></th>
        <th><%= sortable_header("Seller", "seller", @sent_sort, @sent_dir, sort_param: "sent_sort", dir_param: "sent_dir") %></th>
        <th><%= sortable_header("My Offer", "price", @sent_sort, @sent_dir, sort_param: "sent_sort", dir_param: "sent_dir") %></th>
        <th>Message</th>
        <th><%= sortable_header("Status", "status", @sent_sort, @sent_dir, sort_param: "sent_sort", dir_param: "sent_dir") %></th>
        <th><%= sortable_header("Date", "date", @sent_sort, @sent_dir, sort_param: "sent_sort", dir_param: "sent_dir") %></th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @sent_offers.each do |offer| %>
        <tr>
          <td><%= link_to offer.item.title, item_path(offer.item) %></td>
          <td><%= offer.item.seller.email_address %></td>
          <td><%= number_to_currency(offer.price_offered) %></td>
          <td><%= offer.message.presence || "—" %></td>
          <td>
            <% if offer.countered? && offer.counter_price %>
              <span style="color: #b36b00; font-weight: bold;">
                Seller countered: <%= number_to_currency(offer.counter_price) %>
              </span>
            <% else %>
              <%= offer.status.humanize %>
            <% end %>
          </td>
          <td><%= time_ago_in_words(offer.updated_at) %> ago</td>
          <td>
            <% if offer.countered? %>
              <%= button_to "Accept Counter", item_offer_path(offer.item, offer),
                    method: :patch,
                    params: { offer: { status: "accept_counter" } },
                    data: { turbo_confirm: "Accept the counter-offer of #{number_to_currency(offer.counter_price)}?" } %>
              <%= button_to "Reject Counter", item_offer_path(offer.item, offer),
                    method: :patch,
                    params: { offer: { status: "reject_counter" } },
                    data: { turbo_confirm: "Reject the counter-offer? You can make a new offer afterwards." } %>
              <%= button_to "Withdraw", item_offer_path(offer.item, offer),
                    method: :delete,
                    data: { turbo_confirm: "Withdraw this offer?" } %>
            <% elsif offer.pending? %>
              <%= button_to "Withdraw", item_offer_path(offer.item, offer),
                    method: :delete,
                    data: { turbo_confirm: "Withdraw this offer?" } %>
              <%= form_with url: item_offer_path(offer.item, offer), method: :patch, style: "display:inline" do |f| %>
                <%= f.number_field :price_offered, step: 0.01, min: 0.01, placeholder: "New price $", name: "offer[price_offered]", style: "width:100px", value: offer.price_offered %>
                <%= f.submit "Edit Offer $" %>
              <% end %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>You haven't made any offers yet.</p>
<% end %>

<h2>Offers I've Received</h2>
<% if @received_offers.any? %>
  <table>
    <thead>
      <tr>
        <th><%= sortable_header("Item", "item", @recv_sort, @recv_dir, sort_param: "recv_sort", dir_param: "recv_dir") %></th>
        <th><%= sortable_header("Buyer", "buyer", @recv_sort, @recv_dir, sort_param: "recv_sort", dir_param: "recv_dir") %></th>
        <th><%= sortable_header("Amount", "price", @recv_sort, @recv_dir, sort_param: "recv_sort", dir_param: "recv_dir") %></th>
        <th>Message</th>
        <th><%= sortable_header("Status", "status", @recv_sort, @recv_dir, sort_param: "recv_sort", dir_param: "recv_dir") %></th>
        <th><%= sortable_header("Date", "date", @recv_sort, @recv_dir, sort_param: "recv_sort", dir_param: "recv_dir") %></th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @received_offers.each do |offer| %>
        <tr>
          <td><%= link_to offer.item.title, item_path(offer.item) %></td>
          <td><%= offer.buyer.email_address %></td>
          <td><%= number_to_currency(offer.price_offered) %></td>
          <td><%= offer.message.presence || "—" %></td>
          <td>
            <%= offer.status.humanize %>
            <% if offer.countered? && offer.counter_price %>
              (<%= number_to_currency(offer.counter_price) %>)
            <% end %>
          </td>
          <td><%= time_ago_in_words(offer.updated_at) %> ago</td>
          <td>
            <% if offer.pending? %>
              <%= button_to "Accept", item_offer_acceptance_path(offer.item, offer),
                    method: :post,
                    data: { turbo_confirm: "Accept this offer?" } %>
              <%= button_to "Reject", item_offer_rejection_path(offer.item, offer),
                    method: :post,
                    data: { turbo_confirm: "Reject this offer?" } %>
              <%= form_with url: item_offer_path(offer.item, offer), method: :patch, style: "display:inline" do |f| %>
                <%= f.hidden_field :status, value: "countered", name: "offer[status]" %>
                <%= f.number_field :counter_price, step: 0.01, min: 0.01, placeholder: "Counter $", name: "offer[counter_price]", style: "width:100px" %>
                <%= f.submit "Counter" %>
              <% end %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>You haven't received any offers yet.</p>
<% end %>
