<div class="navbar bg-primary text-primary-content shadow-md sticky top-0 z-50 px-6">
  <%# Logo — fixed width to align with sidebar below %>
  <div class="w-56 shrink-0">
    <%= link_to root_path, class: "text-xl font-bold tracking-tight hover:text-accent transition-colors" do %>
      CUHK Marketplace
    <% end %>
  </div>

  <%# Nav links — centered in remaining space %>
  <div class="flex-1">
    <ul class="menu menu-horizontal gap-1 text-primary-content/80 text-sm">
      <li><%= link_to "Items", items_path, class: "hover:text-accent" %></li>
      <li><%= link_to "Communities", communities_path, class: "hover:text-accent" %></li>
      <li><%= link_to "Karma Leaderboard", karma_leaderboard_path, class: "hover:text-accent" %></li>
      <% if authenticated? %>
        <li><%= link_to "Dashboard", dashboard_path, class: "hover:text-accent" %></li>
        <li><%= link_to "Profile", user_path(Current.user), class: "hover:text-accent" %></li>
        <li><%= link_to "Conversations", conversations_path, class: "hover:text-accent" %></li>
      <% end %>
    </ul>
  </div>

  <%# Right actions %>
  <div class="flex items-center gap-2" data-controller="theme">
    <label class="swap swap-rotate btn btn-ghost btn-circle btn-sm text-primary-content/70 hover:text-accent">
      <input type="checkbox" data-theme-target="toggle" data-action="theme#switch">
      <%= lucide_icon("moon", class: "swap-off w-4 h-4") %>
      <%= lucide_icon("sun", class: "swap-on w-4 h-4") %>
    </label>
    <% if authenticated? %>
      <%= button_to session_path, method: :delete, form: { data: { turbo: false }, class: "inline" }, class: "btn btn-ghost btn-sm text-primary-content/70 hover:text-accent" do %>
        <%= lucide_icon("log-out", class: "w-4 h-4") %>
        <span>Log out</span>
      <% end %>
    <% else %>
      <%= link_to "Sign Up", sign_up_path, class: "btn btn-accent btn-sm" %>
      <%= link_to "Log in", new_session_path, class: "btn btn-ghost btn-sm text-primary-content" %>
    <% end %>
  </div>
</div>
