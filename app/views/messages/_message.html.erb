<%# locals: (message:) %>

<% is_mine = message.sender == Current.user %>
<% has_attachment = message.offer.present? || message.item.present? %>

<div id="<%= dom_id(message) %>" class="chat <%= is_mine ? 'chat-end' : 'chat-start' %>">
  <div class="chat-header text-base-content/60">
    <%= is_mine ? "You" : message.sender.full_name %>
  </div>

  <% if has_attachment %>
    <div class="max-w-xs <%= is_mine ? 'col-start-1 justify-self-end' : 'col-start-2 justify-self-start' %>" style="grid-row: 2">
      <% if message.offer.present? %>
        <%= render "messages/attachments/offer", offer: message.offer %>
      <% elsif message.item.present? %>
        <%= render "messages/attachments/item", item: message.item %>
      <% end %>
    </div>
  <% end %>

  <% if message.content.present? %>
    <div class="chat-bubble <%= is_mine ? 'chat-bubble-primary' : 'bg-base-300 text-base-content' %>" <% if has_attachment %>style="grid-row: 3"<% end %>>
      <%= message.content %>
    </div>
  <% end %>

  <div class="chat-footer text-base-content/40" <% if has_attachment %>style="grid-row: 4"<% end %>>
    <time class="text-xs"><%= time_ago(message.created_at) %></time>
  </div>
</div>
