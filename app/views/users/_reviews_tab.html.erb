<%# locals: (reviews:) %>

<% if reviews.any? %>
  <div class="space-y-3">
    <% reviews.each do |review| %>
      <div class="p-4 bg-base-200 rounded-box">
        <div class="flex items-start justify-between gap-4">
          <div class="flex items-center gap-3">
            <%= render "shared/user_avatar", user: review.reviewer, size: "sm" %>
            <div>
              <div class="flex items-center gap-2">
                <%= link_to review.reviewer.full_name, user_path(review.reviewer), class: "font-semibold link link-hover" %>
                <span class="badge badge-sm badge-ghost"><%= review.seller_review? ? "as buyer" : "as seller" %></span>
              </div>
              <p class="text-xs text-base-content/50"><%= time_ago_in_words(review.created_at) %> ago</p>
            </div>
          </div>
          <div class="flex items-center gap-1">
            <% if review.rating == 1 %>
              <%= lucide_icon("thumbs-up", class: "w-5 h-5 text-success") %>
              <span class="text-sm font-semibold text-success">Positive</span>
            <% else %>
              <%= lucide_icon("thumbs-down", class: "w-5 h-5 text-error") %>
              <span class="text-sm font-semibold text-error">Negative</span>
            <% end %>
          </div>
        </div>
        <% if review.comment.present? %>
          <p class="mt-2 text-sm"><%= review.comment %></p>
        <% end %>
        <p class="mt-1 text-xs text-base-content/50">
          <%= lucide_icon("tag", class: "w-3 h-3 inline") %>
          <%= link_to review.offer.item.title, item_path(review.offer.item), class: "link link-hover" %>
        </p>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="flex items-center gap-2 text-base-content/50 py-4">
    <%= lucide_icon("message-square", class: "w-5 h-5") %>
    <span>No reviews yet.</span>
  </div>
<% end %>
