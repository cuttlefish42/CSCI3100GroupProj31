<div class="container mx-auto p-4">
  <h2>Marketplace Items</h2>

  <div class="mb-6">
    <%= link_to "New Item", new_item_path, class: "btn btn-primary" if authenticated? %>
  </div>

  <% if @items.any? %>
      <%# Grid layout %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @items.each do |item| %>
        <%= render item, link_title: true %>
      <% end %>
    </div>
  <% else %>
    <p class="text-neutral/70 italic">No items yet.</p>
  <% end %>
</div>
