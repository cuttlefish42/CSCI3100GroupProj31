<%= render "header" %>

<h1><%= @item.title %></h1>

<p><strong><%= number_to_currency(@item.price) %></strong></p>

<p>
	Category: <%= @item.category.name %><br>
	Condition: <%= @item.condition.humanize %><br>
	Community: <%= @item.community&.name || "Any" %><br>
	Status: <%= @item.status.humanize %><br>
	Seller: <%= @item.seller.username %>
</p>

<p>
	<%= link_to "Back", items_path %>
    | <%= link_to "Edit", edit_item_path(@item) %>
    | <%= link_to "Delete", @item, data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
</p>

<%# === Offer Form (for logged-in buyers, only on available items) === %>
<% if Current.user && Current.user != @item.seller && @item.available? %>
  <h2>Make an Offer</h2>
  <%= form_with model: [@item, @offer] do |f| %>
    <p>
      <%= f.label :price_offered, "Your Offer ($)" %><br>
      <%= f.number_field :price_offered, step: 0.01, min: 0.01, required: true %>
    </p>
    <p>
      <%= f.label :message, "Message (optional)" %><br>
      <%= f.text_area :message, rows: 3, placeholder: "Add a note to the seller..." %>
    </p>
    <p><%= f.submit "Submit Offer" %></p>
  <% end %>
<% end %>

<%# === Offers list (visible to seller) === %>
<% if Current.user == @item.seller && @offers.any? %>
  <h2>Offers Received</h2>
  <table>
    <thead>
      <tr>
        <th>Buyer</th>
        <th>Amount</th>
        <th>Message</th>
        <th>Status</th>
        <th>Date</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @offers.each do |offer| %>
        <tr>
          <td><%= offer.buyer.email_address %></td>
          <td><%= number_to_currency(offer.price_offered) %></td>
          <td><%= offer.message.presence || "—" %></td>
          <td>
            <%= offer.status.humanize %>
            <% if offer.countered? && offer.counter_price %>
              (<%= number_to_currency(offer.counter_price) %>)
            <% end %>
          </td>
          <td><%= time_ago_in_words(offer.created_at) %> ago</td>
          <td>
            <% if offer.pending? %>
              <%= button_to "Accept", item_offer_path(@item, offer),
                    method: :patch,
                    params: { offer: { status: "accepted" } },
                    data: { turbo_confirm: "Accept this offer?" } %>
              <%= button_to "Reject", item_offer_path(@item, offer),
                    method: :patch,
                    params: { offer: { status: "rejected" } },
                    data: { turbo_confirm: "Reject this offer?" } %>
              <%= form_with url: item_offer_path(@item, offer), method: :patch, style: "display:inline" do |f| %>
                <%= f.hidden_field :status, value: "countered", name: "offer[status]" %>
                <%= f.number_field :counter_price, step: 0.01, min: 0.01, placeholder: "Counter $", name: "offer[counter_price]", style: "width:100px" %>
                <%= f.submit "Counter" %>
              <% end %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<%# === Buyer's own offers on this item === %>
<% if Current.user && Current.user != @item.seller %>
  <% my_offers = @offers.select { |o| o.buyer_id == Current.user.id } %>
  <% if my_offers.any? %>
    <h2>Your Offers</h2>
    <% my_offers.each do |offer| %>
      <p>
        <%= number_to_currency(offer.price_offered) %> —
        <strong><%= offer.status.humanize %></strong>
        <% if offer.countered? && offer.counter_price %>
          (Seller countered: <%= number_to_currency(offer.counter_price) %>)
        <% end %>
        <% if offer.message.present? %>
          <br><em>"<%= offer.message %>"</em>
        <% end %>
        <br><small><%= time_ago_in_words(offer.created_at) %> ago</small>
        <% if offer.pending? %>
          <%= button_to "Withdraw", item_offer_path(@item, offer),
                method: :delete,
                data: { turbo_confirm: "Withdraw this offer?" } %>
        <% end %>
      </p>
    <% end %>
  <% end %>
<% end %>
