<%# locals: (trades:, user:) %>

<% if trades.any? %>
  <div class="space-y-3">
    <% trades.each do |trade| %>
      <div class="flex items-center gap-4 p-4 bg-base-200 rounded-box">
        <div class="flex-1 min-w-0">
          <h3 class="font-semibold">
            <%= link_to trade.item.title, item_path(trade.item), class: "link link-hover" %>
          </h3>
          <p class="text-sm text-base-content/60">
            <% if user == trade.buyer %>
              Bought from <%= trade.item.seller.full_name %>
            <% else %>
              Sold to <%= trade.buyer.full_name %>
            <% end %>
          </p>
        </div>
        <div class="text-right">
          <p class="font-bold text-secondary"><%= number_to_currency(trade.price_offered) %></p>
          <p class="text-xs text-base-content/50"><%= trade.updated_at.strftime("%b %d, %Y") %></p>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="flex items-center gap-2 text-base-content/50 py-4">
    <%= lucide_icon("handshake", class: "w-5 h-5") %>
    <span>No completed trades yet.</span>
  </div>
<% end %>
