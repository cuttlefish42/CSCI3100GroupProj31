<header>
  <h1>CUHK Marketplace</h1>
  <div style="display:flex; gap:1rem;">
    <div><%= link_to "Items", items_path %></div>
    <div><%= link_to "Dashboard", dashboard_path %></div>
    <div><%= link_to "Karma Leaderboard", "#karma" %></div>
    <div>
      <% if authenticated? %>
        <%= link_to "Log out", session_path, data: { turbo_method: :delete } %>
      <% else %>
        <%= link_to "Log in", new_session_path %>
      <% end %>
    </div>
  </div>
</header>
<br>
<hr>
