<tr>
  <td><%= link_to offer.item.title, item_path(offer.item) %></td>
  <td><%= link_to offer.buyer.full_name, user_path(offer.buyer) %></td>
  <td><%= price(offer.counter_price || offer.price_offered) %></td>
  <td><%= offer.message.presence || "—" %></td>
  <td>
    <span class="text-success font-bold">Accepted</span>
  </td>
  <td><%= time_ago(offer.updated_at) %></td>
  <td>
    <div class="flex flex-col gap-2 items-center justify-center">
      <% if offer.reviewable_by?(Current.user) %>
        <%= link_to "Leave a Review",
              new_item_offer_review_path(offer.item, offer),
              class: "btn btn-sm btn-success w-full" %>
      <% else %>
        <span class="badge badge-ghost">Reviewed</span>
        <% unless offer.completed? %>
          <span class="text-xs text-base-content/50">Waiting for other party</span>
        <% end %>
      <% end %>
      <%= link_to "View Details", item_path(offer.item), class: "btn btn-sm btn-primary w-full" %>
      <% other_user_id = Current.user.id == offer.buyer_id ? offer.item.seller_id : offer.buyer_id %>
      <%= button_to "Message", conversations_path(item_id: offer.item_id),
            params: { receiver_id: other_user_id },
            class: "btn btn-sm btn-info w-full" %>
    </div>
  </td>
</tr>