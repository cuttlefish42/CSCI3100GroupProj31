<div class="container mx-auto p-4 max-w-md">
  <h1 class="text-2xl font-bold mb-2">Make an Offer</h1>
  <p class="mb-4 text-base-content/70">
    <%= link_to @item.title, item_path(@item) %> — Listed at <strong><%= price(@item.price) %></strong>
  </p>

  <%= form_with model: [@item, @offer], class: "flex flex-col gap-4" do |f| %>
    <% if @offer.errors.any? %>
      <div class="alert alert-error mb-4">
        <ul class="list-disc list-inside">
          <% @offer.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-control">
      <%= f.label :price_offered, "Your Offer ($)", class: "label font-semibold" %>
      <%= f.text_field :price_offered, required: true, inputmode: "decimal", pattern: "\\d+(\\.\\d{1,2})?", placeholder: "0.00", class: "w-full input input-bordered" %>
    </div>

    <div class="form-control">
      <%= f.label :message, "Message (optional)", class: "label font-semibold" %>
      <%= f.text_area :message, rows: 3, class: "textarea textarea-bordered w-full", placeholder: "Add a note to the seller..." %>
    </div>

    <div class="flex gap-2">
      <%= f.submit "Submit Offer", class: "btn btn-primary" %>
      <%= link_to "Cancel", item_path(@item), class: "btn btn-ghost" %>
    </div>
  <% end %>
</div>
