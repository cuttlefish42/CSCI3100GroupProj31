<div class="p-6">
  <%# Header %>
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-3xl font-bold">Marketplace</h1>
      <p class="text-sm text-base-content/50 mt-1">
        <span class="font-semibold text-base-content"><%= @items.count %></span> item<%= @items.count != 1 ? "s" : "" %> available
      </p>
    </div>
    <% if authenticated? %>
      <%= link_to new_item_path, class: "btn btn-primary" do %>
        <%= lucide_icon("plus", class: "w-4 h-4") %> List Item
      <% end %>
    <% end %>
  </div>

  <%# Search & Filter %>
  <% has_filters = params[:keyword].present? || params[:community_id].present? ||
      params[:min_price].present? || params[:max_price].present? ||
      params[:start_date].present? || params[:end_date].present? %>
  <div class="card bg-base-100 shadow-sm mb-6 <%= 'collapse-open' if has_filters %>">
    <div class="collapse collapse-arrow">
      <input type="checkbox" <%= "checked" if has_filters %> />
      <div class="collapse-title font-semibold flex items-center gap-2 text-sm">
        <%= lucide_icon("sliders-horizontal", class: "w-4 h-4 text-primary") %> Search & Filter
      </div>
      <div class="collapse-content">
        <%= form_with url: items_path, method: :get, data: { turbo: false }, class: "space-y-4" do |f| %>
          <div class="grid grid-cols-2 gap-4">
            <div class="form-control">
              <%= f.label :keyword, "Search", class: "label text-xs font-semibold uppercase text-base-content/50" %>
              <%= f.text_field :keyword, placeholder: "Search items...", value: params[:keyword],
                  class: "input input-bordered input-sm w-full" %>
            </div>
            <div class="form-control">
              <%= f.label :community_id, "Community", class: "label text-xs font-semibold uppercase text-base-content/50" %>
              <%= f.select :community_id,
                  options_for_select([["All", ""]] + Community.pluck(:name, :id), params[:community_id]),
                  { include_blank: false }, class: "select select-bordered select-sm w-full" %>
            </div>
          </div>

          <div class="grid grid-cols-4 gap-4">
            <div class="form-control">
              <%= f.label :min_price, "Min $", class: "label text-xs font-semibold uppercase text-base-content/50" %>
              <%= f.number_field :min_price, placeholder: "0", value: params[:min_price],
                  step: 0.01, class: "input input-bordered input-sm w-full" %>
            </div>
            <div class="form-control">
              <%= f.label :max_price, "Max $", class: "label text-xs font-semibold uppercase text-base-content/50" %>
              <%= f.number_field :max_price, placeholder: "∞", value: params[:max_price],
                  step: 0.01, class: "input input-bordered input-sm w-full" %>
            </div>
            <div class="form-control">
              <%= f.label :sort_by, "Sort by", class: "label text-xs font-semibold uppercase text-base-content/50" %>
              <%= f.select :sort_by,
                  options_for_select([["Date", "date"], ["Price", "price"], ["Views", "views"],
                    ["Likes", "likes"], ["Title", "title"]], params[:sort_by] || "date"),
                  { include_blank: false }, class: "select select-bordered select-sm w-full" %>
            </div>
            <div class="form-control">
              <%= f.label :sort_direction, "Order", class: "label text-xs font-semibold uppercase text-base-content/50" %>
              <%= f.select :sort_direction,
                  options_for_select([["Descending", "desc"], ["Ascending", "asc"]], params[:sort_direction] || "desc"),
                  { include_blank: false }, class: "select select-bordered select-sm w-full" %>
            </div>
          </div>

          <div class="flex gap-2">
            <%= f.submit "Apply", class: "btn btn-primary btn-sm" %>
            <%= link_to "Reset", items_path, class: "btn btn-ghost btn-sm", data: { turbo: false } %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <% if has_filters %>
    <div class="flex flex-wrap gap-2 mb-6">
      <% if params[:keyword].present? %>
        <%= link_to items_path(request.query_parameters.except(:keyword)), class: "badge badge-primary badge-outline gap-1", data: { turbo: false } do %>
          Keyword: <%= params[:keyword] %> ×
        <% end %>
      <% end %>
      <% if params[:community_id].present? %>
        <%= link_to items_path(request.query_parameters.except(:community_id)), class: "badge badge-primary badge-outline gap-1", data: { turbo: false } do %>
          <%= Community.find_by(id: params[:community_id])&.name %> ×
        <% end %>
      <% end %>
      <% if params[:min_price].present? %>
        <%= link_to items_path(request.query_parameters.except(:min_price)), class: "badge badge-primary badge-outline gap-1", data: { turbo: false } do %>
          Min: $<%= params[:min_price] %> ×
        <% end %>
      <% end %>
      <% if params[:max_price].present? %>
        <%= link_to items_path(request.query_parameters.except(:max_price)), class: "badge badge-primary badge-outline gap-1", data: { turbo: false } do %>
          Max: $<%= params[:max_price] %> ×
        <% end %>
      <% end %>
    </div>
  <% end %>

  <% if @items.any? %>
    <div class="grid grid-cols-2 lg:grid-cols-3 gap-5">
      <% @items.each do |item| %>
        <%= render item, link_title: true %>
      <% end %>
    </div>
  <% else %>
    <div class="card bg-base-100 shadow-sm p-16 text-center">
      <%= lucide_icon("search-x", class: "w-12 h-12 text-base-content/30 mx-auto mb-4") %>
      <p class="text-lg font-semibold text-base-content/50">No items found</p>
      <p class="text-sm text-base-content/40">Try adjusting your filters.</p>
    </div>
  <% end %>
</div>
