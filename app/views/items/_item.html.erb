<%# locals: (item:, link_title: false, large_photo: false) %>

<% if item.photo.attached? %>
  <div <%= large_photo ? 'style="margin: 12px 0;"'.html_safe : "" %>>
    <% if large_photo %>
      <%= image_tag item.photo, style: "max-width: 400px; max-height: 400px; border-radius: 4px;" %>
    <% else %>
      <%= image_tag item.photo, style: "max-width: 150px; max-height: 150px; border-radius: 4px;" %>
    <% end %>
  </div>
<% end %>

<div class="item-info">
  <h2>
    <% if link_title %>
      <%= link_to item.title, item %>
    <% else %>
      <%= item.title %>
    <% end %>
  </h2>

  <p><strong><%= number_to_currency(item.price) %></strong></p>

  <p>
    Category: <%= item.category.name %><br>
    Condition: <%= item.condition.humanize %><br>
    Community: <%= item.community&.name || "Any" %><br>
    Status: <%= item.status.humanize %><br>
    Seller: <%= item.seller.username %> [<%= item.seller.karma %>]<br>
  </p>
</div>
