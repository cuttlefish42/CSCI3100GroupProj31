<div class="container mx-auto p-4 max-w-md">
  <h1 class="text-2xl font-bold mb-2">
    Rate <%= @review.reviewee.full_name %>
  </h1>
  <p class="mb-4 text-base-content/70">
    Transaction: <strong><%= @item.title %></strong>
    (<%= price(@offer.counter_price || @offer.price_offered) %>)
  </p>

  <%= form_with model: @review,
                url: item_offer_review_path(@item, @offer) do |f| %>
    <% if @review.errors.any? %>
      <div class="alert alert-error mb-4">
        <ul class="list-disc list-inside">
          <% @review.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-control mb-4">
      <label class="label"><span class="label-text">Rating</span></label>
      <div class="flex gap-2">
        <label class="btn btn-success flex-1 cursor-pointer">
          <%= f.radio_button :rating, 1, class: "mr-2" %> +1 Karma
        </label>
        <label class="btn btn-error flex-1 cursor-pointer">
          <%= f.radio_button :rating, -1, class: "mr-2" %> -1 Karma
        </label>
      </div>
    </div>

    <div class="form-control mb-4">
      <%= f.label :comment, "Comment (optional)", class: "label" %>
      <%= f.text_area :comment,
                      rows: 3,
                      class: "textarea textarea-bordered w-full" %>
    </div>

    <div class="flex gap-2">
      <%= f.submit "Submit Review", class: "btn btn-primary" %>
      <%= link_to "Cancel", dashboard_path, class: "btn btn-ghost" %>
    </div>
  <% end %>
</div>