<style>
  body { background-color: #f9fafb; }
  
  @keyframes float {
    0% { transform: translateY(0px); }
    50% { transform: translateY(-12px); }
    100% { transform: translateY(0px); }
  }
  @keyframes borderPulse {
    0% { box-shadow: 0 0 0 0 rgba(75, 0, 130, 0.1); }
    50% { box-shadow: 0 0 25px 5px rgba(255, 215, 0, 0.3); }
    100% { box-shadow: 0 0 0 0 rgba(75, 0, 130, 0.1); }
  }

  .login-card {
    max-width: 450px;
    margin: 60px auto;
    padding: 40px 30px;
    border-radius: 16px;
    font-family: 'Poppins', sans-serif;
    background: linear-gradient(#ffffff, #ffffff) padding-box,
                linear-gradient(135deg, #FFD700, #4B0082, #FFD700) border-box;
    border: 4px solid transparent;
    
    animation: borderPulse 4s infinite alternate;
  }

  .new-logo-container {
    display: flex; flex-direction: column; align-items: center; gap: 15px; margin-bottom: 35px;
  }
  .logo-image-wrapper {
    width: 120px; height: 120px; display: flex; align-items: center; justify-content: center;
    
    animation: float 4s ease-in-out infinite;
  }
  .logo-image-wrapper img {
    width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 10px 15px rgba(75, 0, 130, 0.2));
  }
  .logo-text-wrapper {
    display: flex; flex-direction: column; align-items: center; gap: 2px;
    
  }
  .logo-title { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 36px; font-weight: 800; letter-spacing: -0.025em; color: #4B0082; }
  .logo-gradient-line { height: 4px; width: 96px; border-radius: 9999px; background: linear-gradient(to right, #FFD700, #4B0082); margin-top: 4px; }

  

  .custom-input {
    width: 100%; padding: 14px; margin-top: 6px; border: 2px solid #e2e8f0; border-radius: 8px; box-sizing: border-box; font-family: 'Poppins', sans-serif; transition: all 0.3s ease; background-color: #f8fafc;
  }
  .custom-input:focus { border-color: #4B0082; background-color: #ffffff; box-shadow: 0 0 0 4px rgba(75, 0, 130, 0.1); outline: none; transform: translateY(-2px); }

  .checkbox-wrapper { display: flex; align-items: center; gap: 10px; margin-bottom: 25px; cursor: pointer; }
  .animated-checkbox { appearance: none; width: 22px; height: 22px; border: 2px solid #cbd5e1; border-radius: 6px; cursor: pointer; transition: all 0.3s ease; position: relative; margin: 0; }
  
  
  @keyframes popIn { 0% { transform: scale(1); } 50% { transform: scale(1.3); } 100% { transform: scale(1); } }
  .animated-checkbox:checked { background-color: #4B0082; border-color: #4B0082; animation: popIn 0.4s ease-in-out; }
  .animated-checkbox:checked::after { content: '✔'; position: absolute; color: white; font-size: 14px; left: 4px; top: 0px; }

  .custom-btn {
    width: 100%; background: linear-gradient(135deg, #4B0082, #6a0dad); color: white; padding: 14px; border: none; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer; font-family: 'Poppins', sans-serif; transition: all 0.3s ease; box-shadow: 0 4px 15px rgba(75, 0, 130, 0.2);
  }
  
  .custom-btn:hover { background: linear-gradient(135deg, #3a0066, #4B0082); transform: translateY(-3px) scale(1.02); box-shadow: 0 8px 20px rgba(75, 0, 130, 0.4); }
</style>

<div class="login-card">
  <div class="new-logo-container">
    <div class="logo-image-wrapper">
      <%= image_tag "icon_temp.png", alt: "hands trading" %>
    </div>
    <div class="logo-text-wrapper">
      <span class="logo-title">CUHK Marketplace</span>
      <div class="logo-gradient-line"></div>
    </div>
  </div>

  <%= form_with url: session_path do |form| %>
    <div style="margin-bottom: 20px;">
      <%= form.label :email_address, "Email", style: "font-weight: 600; color: #555; font-size: 14px;" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "email", class: "custom-input" %>
    </div>

    <div style="margin-bottom: 20px;">
      <%= form.label :password, style: "font-weight: 600; color: #555; font-size: 14px;" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", class: "custom-input" %>
    </div>

    <div>
      <label class="checkbox-wrapper">
        <input type="checkbox" class="animated-checkbox" name="remember_me">
        <span style="font-size: 14px; color: #666; font-weight: 500;">Remember me</span>
      </label>
    </div>

    <div>
      <%= form.submit "Log in", class: "custom-btn" %>
    </div>
  <% end %>
  
  <div style="text-align: center; margin-top: 25px; font-size: 14px;">
    <%= link_to "Forgot password?", new_password_path, style: "color: #4B0082; text-decoration: none; font-weight: 600; transition: all 0.3s ease;" %>
  </div>

  <div style="text-align: center; margin-top: 15px; font-size: 14px; color: #666;">
    Don't have an account? 
    <%= link_to "Register here", new_registration_path, style: "color: #4B0082; text-decoration: none; font-weight: 600; transition: all 0.3s ease;" %>
  </div>
</div>