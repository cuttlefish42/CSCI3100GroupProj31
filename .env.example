# Copy this file to .env and fill in the values. .env is gitignored.
#
# These variables are consumed by Kamal when you run `bin/kamal deploy`.
# They are NOT needed for plain `bin/dev` local development — Rails reads
# RAILS_MASTER_KEY from config/master.key directly.

# Rails master key. Decrypts config/credentials.yml.enc.
# Source: copy the contents of config/master.key (gitignored). For teammates,
# share it via a password manager — never commit it.
RAILS_MASTER_KEY=

# SSH host (or IP) of the production server. This is the value Kamal connects
# to as the `server1` host alias defined in config/deploy.yml.
EC2_INSTANCE_ADDRESS=

# Password for the GitHub Container Registry (ghcr.io). Used by Kamal to push
# the built image. Create a Personal Access Token with `write:packages` scope
# at https://github.com/settings/tokens (classic) and paste it here.
KAMAL_REGISTRY_PASSWORD=

# GitHub token used during `docker build` (e.g. for fetching private packages).
# A PAT with `read:packages` scope is sufficient. Can be the same value as
# KAMAL_REGISTRY_PASSWORD if it has both scopes.
GITHUB_TOKEN=


POSTGRES_PASSWORD=
