<%# locals: (item:, existing_offer:, offer:) %>

<div class="w-full md:w-80 flex flex-col gap-4">
  <div class="card bg-base-100 shadow-lg">
    <div class="card-body">
      <div class="flex items-center gap-4">
        <%= render "shared/user_avatar", user: item.seller, size: "lg" %>
        <div>
          <p class="font-bold text-base"><%= link_to item.seller.full_name, user_path(item.seller) %></p>
          <p class="text-sm"><span class="badge badge-accent badge-sm font-semibold">Karma: <%= item.seller.karma %></span></p>
        </div>
      </div>

      <div class="divider my-2"></div>

<%# === Offer section (for logged-in buyers, only on available items) === %>
<% if Current.user && Current.user != item.seller && item.available? %>
  <% if existing_offer %>
    <div class="alert bg-primary/10 text-base-content text-sm">
      <div>
        <p class="font-semibold">You have an active offer on this item</p>
        <p class="text-xs"><%= price(existing_offer.price_offered) %> &mdash; <%= existing_offer.status.humanize %></p>
        <% if existing_offer.countered? && existing_offer.counter_price %>
          <p class="text-xs text-warning font-semibold mt-1">Seller countered: <%= price(existing_offer.counter_price) %></p>
        <% end %>
      </div>
    </div>

  <% else %>
    <%= link_to "Make an Offer", new_item_offer_path(item), class: "btn btn-outline btn-primary w-full my-2" %>
  <% end %>
<% end %>

<% if Current.user && Current.user != item.seller %>
  <%= button_to "Chat", conversations_path(item_id: item.id),
      params: { receiver_id: item.seller.id },
      class: "btn btn-primary btn-lg w-full" %>
<% end %>

    </div>
  </div>
</div>
