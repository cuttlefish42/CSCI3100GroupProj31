<%= render "header" %>

<h2>Marketplace Items</h2>

<p>
  <%= link_to "New Item", new_item_path if authenticated? %>
</p>

<% if @items.any? %>
  <ul>
    <% @items.each do |item| %>
      <li style="margin-bottom: 1rem;">
        <h3><%= link_to item.title, item %></h3>
        <p><strong><%= number_to_currency(item.price) %></strong></p>

        <p>
          Category: <%= item.category.name %><br>
          Condition: <%= item.condition.humanize %><br>
          Community: <%= item.community&.name || "Any" %><br>
          Status: <%= item.status.humanize %>
          Seller: <%= item.seller.username %><br>
        </p>

      </li>
    <% end %>
  </ul>
<% else %>
  <p>No items yet.</p>
<% end %>
