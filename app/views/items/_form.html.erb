<% if item.errors.any? %>
  <div class="alert alert-error mb-6 shadow-md">
    <div>
      <h3 class="font-bold"><%= pluralize(item.errors.count, "error") %> prohibited this item from being saved:</h3>
      <ul class="list-disc list-inside ml-2">
        <% item.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  </div>
<% end %>

<%= form_with model: item, class: "flex flex-col gap-4" do |form| %>
  <div class="form-control">
    <%= form.label :title, class: "label font-semibold" %>
    <%= form.text_field :title, required: true, class: "w-full" %>
  </div>

  <div class="form-control">
    <%= form.label :description, class: "label font-semibold" %>
    <%= form.text_area :description, required: true, rows: 4, class: "textarea textarea-bordered w-full" %>
  </div>

  <div class="form-control">
    <%= form.label :price, class: "label font-semibold" %>
    <%= form.number_field :price, step: 0.1, min: 0, required: true, class: "w-full" %>
  </div>

  <div class="form-control">
    <%= form.label :category_id, "Category", class: "label font-semibold" %>
    <%= form.collection_select :category_id, Category.all, :id, :name, { prompt: "Select category" }, required: true, class: "w-full" %>
  </div>

  <div class="form-control">
    <%= form.label :community_id, "Community", class: "label font-semibold" %>
    <%= form.collection_select :community_id, Community.all, :id, :name, { include_blank: "Any community" }, class: "w-full" %>
  </div>

  <div class="form-control">
    <%= form.label :condition, class: "label font-semibold" %>
    <%= form.select :condition, Item.conditions.keys.map { |c| [c.humanize, c] }, {}, required: true, class: "w-full" %>
  </div>

  <%# TODO: Status would be by default Available. Change after state management is implemented. %>
  <div class="form-control">
    <%= form.label :status, class: "label font-semibold" %>
    <%= form.select :status, Item.statuses.keys.map { |s| [s.humanize, s] }, {}, required: true, class: "w-full" %>
  </div>

  <div class="form-control">
    <%= form.label :meetup_note, "Meetup Note (optional)", class: "label font-semibold" %>
    <%= form.text_field :meetup_note, placeholder: "e.g. Meet at Shaw College lobby", class: "w-full" %>
  </div>

  <div class="form-control" data-controller="map-picker"
       data-map-picker-lat-value="<%= item.latitude || 22.4196 %>"
       data-map-picker-lng-value="<%= item.longitude || 114.2068 %>">
    <label class="label font-semibold">Meetup Location (click map to set pin)</label>
    <%= form.hidden_field :latitude, data: { map_picker_target: "lat" } %>
    <%= form.hidden_field :longitude, data: { map_picker_target: "lng" } %>
    <div data-map-picker-target="map" style="height: 300px; border-radius: 8px; border: 1px solid #ccc;"></div>
  </div>

  <div class="form-control">
    <%= form.label :photo, "Product Photo", class: "label font-semibold" %>
    <% if item.photo.attached? %>
      <div class="mb-2">
        <span class="text-sm text-neutral/70">Current photo:</span>
        <%= image_tag item.photo, class: "max-h-48 rounded-box mt-1 object-cover" %>
      </div>
    <% end %>
    <%= form.file_field :photo, accept: "image/*", class: "file-input file-input-bordered w-full" %>
  </div>

  <div class="mt-4">
    <%= form.submit class: "btn btn-primary w-full" %>
  </div>
<% end %>
